<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Speed Ball"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live floating network speed monitor"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shows download/upload speed and ping"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:padding="16dp"
        android:background="#192134"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ball_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ 12.4 MB/s"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#22C55E"
                android:fontFamily="monospace"
                android:shadowColor="#22C55E"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ 2.1 MB/s"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00AAFF"
                android:fontFamily="monospace"
                android:shadowColor="#00AAFF"
                android:shadowRadius="3"
                android:shadowDx="0"
                android:shadowDy="0"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ping: 12 ms"
                android:textSize="12sp"
                android:textColor="#FFAA00"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/grant_permission"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:backgroundTint="#22C55E"
        android:layout_marginBottom="12dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/start_service"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:backgroundTint="#00AAFF"
        android:enabled="false"
        android:layout_marginBottom="12dp"
        android:stateListAnimator="@null"/>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/stop_service"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#DC2626"
        android:layout_marginBottom="24dp"
        android:stateListAnimator="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ Drag to move  •  Tap to minimize"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requires "Display over other apps" permission"
            android:textSize="12sp"
            android:textColor="#475569"
            android:gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>